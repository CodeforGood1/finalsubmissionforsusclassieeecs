# Sustainable Classroom LMS - Single Environment Template
#
# This is the only env example file in the repository.
#
# Create one runtime file from this template:
# - .env at the project root
#
# Docker Compose, backend/server.js, backend/seed.js, and Vite all read
# the root .env file.
#
# Keep real .env files out of git.

# ------------------------------------------------------------------
# Shared values for Docker Compose, backend, and frontend
# ------------------------------------------------------------------
DOCKER_HOST_ADDRESS=127.0.0.1
TZ=Asia/Kolkata

DB_USER=lms_user
DB_PASSWORD=replace-with-generated-db-password
DB_NAME=lms_db

ADMIN_EMAIL=admin@classroom.local
ADMIN_PASSWORD=replace-with-generated-admin-password
JWT_SECRET=replace-with-generated-jwt-secret

JITSI_PUBLIC_URL=https://localhost:8443
JICOFO_AUTH_PASSWORD=replace-with-generated-jicofo-password
JICOFO_COMPONENT_SECRET=replace-with-generated-jicofo-secret
JVB_AUTH_PASSWORD=replace-with-generated-jvb-password

# Host ports. If setup says a port is already in use, change only the
# HOST_* value on the left side of the mapping and rerun setup.
HOST_POSTGRES_PORT=5432
HOST_SMTP_PORT=1025
HOST_MAILHOG_WEB_PORT=8025
HOST_BACKEND_PORT=5000
HOST_HTTP_PORT=80
HOST_JITSI_HTTPS_PORT=8443
HOST_JITSI_JVB_UDP_PORT=10000
HOST_JITSI_COLIBRI_PORT=4443

# Use localhost for local `node server.js`.
# Full Docker Compose overrides backend SMTP to `mailhog` inside the Docker network.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM_NAME=Sustainable Classroom
EMAIL_FROM_ADDRESS=noreply@classroom.local

# Optional real SMTP example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-google-app-password
# EMAIL_FROM_ADDRESS=your-email@gmail.com

# ------------------------------------------------------------------
# Backend values for local Node backend
# ------------------------------------------------------------------
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://lms_user:replace-with-generated-db-password@localhost:5432/lms_db
DB_SSL=false

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=524288000

DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL_HOURS=24
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_MAX_FILES=14
DB_BACKUP_DIR=./backups/database
DB_BACKUP_RUN_ON_START=false

SMTP_IGNORE_TLS=true
EMAIL_DEV_MODE=false

FRONTEND_URL=http://localhost:5173
JITSI_SERVER_URL=https://localhost:8443

ENABLE_REGISTRATION=true
ENABLE_PDF_GENERATION=true
ENABLE_CODE_EXECUTION=true
ENABLE_NOTIFICATIONS=true
OFFLINE_MODE=false

# ------------------------------------------------------------------
# Frontend values for Vite
# ------------------------------------------------------------------
VITE_API_URL=http://localhost:5000
VITE_JITSI_SERVER_URL=https://localhost:8443
VITE_APP_MODE=development
VITE_DEBUG=true
