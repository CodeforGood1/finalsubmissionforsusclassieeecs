# Sustainable Classroom LMS - Single Environment Template
#
# This is the only env example file in the repository.
#
# Create one runtime file from this template:
# - .env at the project root
#
# Docker Compose, backend/server.js, backend/seed.js, and Vite all read
# the root .env file.
#
# Keep real .env files out of git.

# ------------------------------------------------------------------
# Shared values for Docker Compose, backend, and frontend
# ------------------------------------------------------------------
DOCKER_HOST_ADDRESS=127.0.0.1
TZ=Asia/Kolkata

DB_USER=lms_user
DB_PASSWORD=lms_password
DB_NAME=lms_db

ADMIN_EMAIL=admin@classroom.local
ADMIN_PASSWORD=admin123
JWT_SECRET=local_dev_jwt_secret_change_before_production_2026

JITSI_PUBLIC_URL=https://localhost:8443
JICOFO_AUTH_PASSWORD=jicofo-offline-2026
JICOFO_COMPONENT_SECRET=jicofo-component-offline-2026
JVB_AUTH_PASSWORD=jvb-offline-2026

# Use localhost for local `node server.js`.
# Full Docker Compose overrides backend SMTP to `mailhog` inside the Docker network.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM_NAME=Sustainable Classroom
EMAIL_FROM_ADDRESS=noreply@classroom.local

# Optional real SMTP example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-google-app-password
# EMAIL_FROM_ADDRESS=your-email@gmail.com

# ------------------------------------------------------------------
# Backend values for local Node backend
# ------------------------------------------------------------------
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://lms_user:lms_password@localhost:5432/lms_db
DB_SSL=false

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=524288000

SMTP_IGNORE_TLS=true
EMAIL_DEV_MODE=false

FRONTEND_URL=http://localhost:5173
JITSI_SERVER_URL=https://localhost:8443

ENABLE_REGISTRATION=true
ENABLE_PDF_GENERATION=true
ENABLE_CODE_EXECUTION=true
ENABLE_NOTIFICATIONS=true
OFFLINE_MODE=false

# ------------------------------------------------------------------
# Frontend values for Vite
# ------------------------------------------------------------------
VITE_API_URL=http://localhost:5000
VITE_JITSI_SERVER_URL=https://localhost:8443
VITE_APP_MODE=development
VITE_DEBUG=true
